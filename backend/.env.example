# ===================================================================
# VANGUARDIQ • BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================================
# Instructions: Copy this file to .env and fill in your actual keys.
# DO NOT commit your .env file to GitHub!

# Server Port (Render automatically supplies PORT in production)
PORT=5001

# AI / LLM Reasoning Engine API Keys
# Provide at least one key below to enable live LangGraph neural reasoning.
# If omitted or rate-limited, VanguardIQ automatically activates its 0-Downtime Simulation Shield.

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_google_gemini_api_key_here

# OR OpenAI API Key (Optional alternative)
# OPENAI_API_KEY=your_openai_api_key_here
